{
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "agent_id",
    "default_action",
    "grants",
    "scope",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "CONFIGURED_NOT_DEPLOYED"
      ]
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "default_action": {
      "const": "DENY"
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "scope",
          "approval_required"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled": {
      "const": false
    }
  },
  "additionalProperties": false
}
