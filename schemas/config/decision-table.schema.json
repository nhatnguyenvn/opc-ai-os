{
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "CONFIGURED_NOT_DEPLOYED"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "conditions",
          "outcome",
          "required_controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "priority": {
            "type": "integer"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "enum": [
              "DENY",
              "HOLD",
              "ESCALATE",
              "APPROVAL_REQUIRED",
              "REVIEW_REQUIRED",
              "ALLOW_WITH_CONDITIONS",
              "ALLOW"
            ]
          },
          "required_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
