{
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "effective_date",
    "controls"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "CONFIGURED_NOT_DEPLOYED"
      ]
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "controls": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "title",
          "severity",
          "rule",
          "hard_control_refs"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "const": "P0"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "hard_control_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
